{
  "manifest_version": 3,
  "name": "Ariba Integration Agent",
  "version": "4.1.1",
  "description": "Ariba Integration Agent \u2014 EDI/cXML conversion, supplier onboarding, CIG workflow automation.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "contextMenus",
    "scripting",
    "tabs",
    "notifications",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.ariba.com/*",
    "https://service.ariba.com/*",
    "https://integration.ariba.com/*",
    "http://*.ariba.com/*",
    "https://*.sap.com/*",
    "https://*.bn.cloud.ariba.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png",
      "256": "icons/icon256.png"
    },
    "default_title": "AIA \u2014 Ariba Integration Agent"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ariba.com/*",
        "https://service.ariba.com/*",
        "https://integration.ariba.com/*",
        "http://*.ariba.com/*",
        "https://*.bn.cloud.ariba.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  },
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Toggle Ariba Integration Agent sidebar"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "styles/*"
      ],
      "matches": [
        "https://*.ariba.com/*",
        "http://*.ariba.com/*"
      ]
    }
  ]
}
